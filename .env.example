# Inject these into PHP-FPM and CLI; this file is documentation, not auto-loaded.
D2S_DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=d2s_portal;charset=utf8mb4
D2S_DB_USER=
D2S_DB_PASSWORD=
D2S_RELEASE=development
# Generated with bin/build-release-manifest.php; required by deployment preflight.
D2S_RELEASE_MANIFEST=
# Reject a new order number if wall time falls behind the persisted high-water
# mark by more than this many seconds. NTP synchronization is still required.
D2S_ORDER_CLOCK_MAX_ROLLBACK_SECONDS=5
# Comma-separated SNTP servers accepted as IPv4, hostname[:port], or [IPv6][:port].
# The default port is 123. Every configured entry must remain syntactically valid.
D2S_NTP_SERVERS=
D2S_NTP_MAX_OFFSET_MS=1000
D2S_NTP_QUORUM=2
D2S_NTP_TIMEOUT_MS=1200
# Keep false for local development; set true in production after verifying NTP sources.
D2S_NTP_REQUIRED=false
# Non-blocking task-runner locks and structured JSONL logs.
D2S_TASK_LOCK_DIR=/www/wwwroot/desktop2stereo-portal/shared/task-locks
D2S_TASK_LOG_DIR=/www/wwwroot/desktop2stereo-portal/shared/task-logs
D2S_TASK_LOG_MAX_BYTES=5242880
D2S_TASK_LOG_KEEP=5
# Default remains off until P4/P7 acceptance.
# Legacy upgrade only: used by migration 0065 when the former database switch is missing.
D2S_PURCHASES_ENABLED=false
# Required for verification HMAC and encrypted outbox. Base64 of a random 32-byte key.
D2S_MASTER_KEY=
D2S_APP_URL=https://d2s.site
# EdgeOne purge outbox remains disabled unless explicitly enabled after deployment acceptance.
D2S_EDGEONE_PURGE_ENABLED=false
D2S_EDGEONE_ZONE_ID=
D2S_TENCENT_SECRET_ID=
D2S_TENCENT_SECRET_KEY=
D2S_ALLOWED_ORIGINS=https://d2s.site,https://d2s.top
# Comma-separated proxy CIDRs allowed to supply EO-Connecting-IP/X-Forwarded-For.
# Leave empty when PHP is directly exposed; configure exact EdgeOne origin-pull ranges in production.
D2S_TRUSTED_PROXY_CIDRS=
# Set true in production after the official EdgeOne origin ranges are verified.
D2S_TRUSTED_PROXY_REQUIRED=false

# Private ticket attachment root. Must remain outside public/ and be writable only by PHP-FPM.
D2S_TICKET_STORAGE=/www/wwwroot/desktop2stereo-portal/storage/tickets
# Encrypted immutable deletion manifests. Persist and back up this directory separately from the database.
D2S_RETENTION_MANIFEST_DIR=/www/wwwroot/desktop2stereo-portal/storage/retention-manifests
# Dedicated retention account for ticket and login-history purge jobs.
D2S_RETENTION_DB_DSN=
D2S_RETENTION_DB_USER=
D2S_RETENTION_DB_PASSWORD=
# Defaults to 366 days and cannot be set below that minimum.
D2S_LOGIN_HISTORY_RETENTION_DAYS=366

# Optional dedicated backup read account. When unset, bin/backup.php uses D2S_DB_*.
D2S_BACKUP_DB_DSN=
D2S_BACKUP_DB_USER=
D2S_BACKUP_DB_PASSWORD=
# Absolute mysqldump path; when empty the CLI searches PATH.
D2S_MYSQLDUMP=

# GitHub latest release cache is refreshed by CLI; web requests only read the cache.
D2S_RELEASE_CACHE=/www/wwwroot/desktop2stereo-portal/storage/cache/github-release.json
# Optional absolute trusted CA bundle path for GitHub TLS. TLS verification is never disabled.
D2S_CA_BUNDLE=
# Optional read-only token for a private release repository. Never expose it to browsers.
D2S_GITHUB_TOKEN=

# Signed web application update source. Private Ed25519 keys remain outside this server.
# Release repository for website updates. Private repositories use the read-only token above.
D2S_UPDATE_GITHUB_REPOSITORY=laiyangli001/desktop2stereo-portal
D2S_UPDATE_PUBLIC_KEY=
D2S_UPDATE_ALLOWED_HOSTS=
D2S_UPDATE_STAGING_DIR=/www/wwwroot/desktop2stereo-portal/storage/updates

# Local-only test helper. Never enable for a non-loopback D2S_APP_URL.
D2S_LOCAL_VERIFICATION_CAPTURE=false

# Select smtp or ses only after setting all required parameters.
D2S_MAIL_DRIVER=
D2S_SMTP_HOST=
D2S_SMTP_PORT=587
D2S_SMTP_USER=
D2S_SMTP_PASSWORD=
D2S_SMTP_FROM=
D2S_SES_SECRET_ID=
D2S_SES_SECRET_KEY=
D2S_SES_REGION=ap-shanghai
D2S_SES_FROM=
D2S_SES_REPLY_TO=
D2S_SES_TEMPLATE_REGISTER=
D2S_SES_TEMPLATE_PASSWORD_RESET=
D2S_SES_TEMPLATE_BIND_CONTACT=
D2S_SES_TEMPLATE_TRANSACTION=

D2S_SMS_ENABLED=false
D2S_SMS_SECRET_ID=
D2S_SMS_SECRET_KEY=
D2S_SMS_REGION=ap-guangzhou
D2S_SMS_APP_ID=
D2S_SMS_SIGN_NAME=
D2S_SMS_TEMPLATE_REGISTER=
D2S_SMS_TEMPLATE_PASSWORD_RESET=
D2S_SMS_TEMPLATE_BIND_CONTACT=
D2S_SMS_TEMPLATE_TRANSACTION=

# P-256 signing key only; never generate ephemeral production keys at startup.
D2S_LICENSE_KEY_ID=
D2S_LICENSE_PRIVATE_KEY_B64=
# Alternatively inject a real multiline PEM; do not configure both.
D2S_LICENSE_PRIVATE_KEY_PEM=
# Existing parallax resource identity and AES-256 content key, through restricted secrets.
D2S_PARALLAX_CORE_SHA256=
D2S_PARALLAX_CORE_KEY_HEX=

# Merchant RSA2 public-key mode; saved admin settings are authoritative.
# The external checkout/notification workflow is not open until integrated and accepted.
D2S_ALIPAY_PC_ENABLED=false
D2S_ALIPAY_ENVIRONMENT=production
D2S_ALIPAY_APP_ID=
D2S_ALIPAY_SELLER_ID=
# Restricted multiline PEM or bare base64 DER; never commit actual key values.
D2S_ALIPAY_PRIVATE_KEY=
D2S_ALIPAY_PUBLIC_KEY=
D2S_ALIPAY_NOTIFY_URL=https://d2s.site/api/v1/alipay/d2s/notify
D2S_ALIPAY_APP_GATEWAY_URL=https://d2s.site/api/v1/alipay/app-gateway
D2S_ALIPAY_RETURN_URL=https://d2s.site/alipay/return
D2S_ALIPAY_QR_PAY_MODE=4
D2S_ALIPAY_QRCODE_WIDTH=240

# WeChat ordinary merchant Native; encrypted admin settings become authoritative.
# Business checkout/notifications are not integrated yet. Activation is rejected.
D2S_WECHAT_ENABLED=false
D2S_WECHAT_APP_ID=
D2S_WECHAT_MCHID=
D2S_WECHAT_MERCHANT_SERIAL=
# Restricted multiline PKCS#8 PEM and 32-byte APIv3 key. Never commit real values.
D2S_WECHAT_PRIVATE_KEY=
D2S_WECHAT_API_V3_KEY=
# Current and optional previous trusted WeChat public-key ID + PEM.
D2S_WECHAT_VERIFICATION_ID=
D2S_WECHAT_VERIFICATION_KEY=
D2S_WECHAT_PREVIOUS_VERIFICATION_ID=
D2S_WECHAT_PREVIOUS_VERIFICATION_KEY=
# Planned fixed routes; do not treat these as accepted notify endpoints yet.
D2S_WECHAT_NOTIFY_URL=https://d2s.site/api/v2/wechat/notify
D2S_WECHAT_REFUND_NOTIFY_URL=https://d2s.site/api/v2/wechat/refund-notify
